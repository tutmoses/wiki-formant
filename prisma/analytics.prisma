// Shipped by wiki-formant (`npx prisma-models`). Edit it there, not here:
// `prisma-models --check` fails on a copy that has drifted.
//
// Page views and events, counted by wiki-formant/analytics. Its SQL names these
// tables as written, so they carry no @@map. A visitor is a hash under the day's
// Salt, which is replaced daily; rows older than 400 days are deleted. `siteId`
// is "" in an app that serves one site.

model View {
  id        BigInt   @id @default(autoincrement())
  siteId    String   @default("")
  path      String
  source    String?
  country   String?
  device    String
  visitor   String
  // Set once its reader has had the page visible fifteen seconds or given it input.
  engaged   Boolean  @default(false)
  // Seconds its page was in a visible tab, capped at an hour; null until its reader hides it or moves on.
  seconds   Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([siteId, createdAt])
}

model Event {
  id        BigInt   @id @default(autoincrement())
  siteId    String   @default("")
  name      String
  path      String?
  props     Json     @default("{}")
  visitor   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([siteId, name, createdAt])
}

// One agent on one UTC day: an AI crawler, an MCP client or anything else
// reading the machine surface. Its requests add to `hits` and its tool calls to
// `tools` ({ tool: calls }); `entry` is the first path it asked for.
model AgentDay {
  siteId  String   @default("")
  day     DateTime @db.Date
  visitor String
  // The crawler roster's label, null for an agent on no roster.
  bot     String?
  ua      String
  country String?
  entry   String?
  hits    Int      @default(1)
  tools   Json     @default("{}")

  @@id([siteId, day, visitor])
}

model Salt {
  day   String @id
  value String
}

// Days a site counted somewhere else before it counted its own, one row a day
// with each breakdown as { value: visitors }. Nothing writes or deletes it:
// the app loads it once, and digest adds the days in a window to the views.
model ViewDay {
  siteId     String   @default("")
  day        DateTime @db.Date
  visitors   Int
  pageviews  Int
  visits     Int
  bounces    Int
  seconds    Int
  pages      Json     @default("{}")
  entryPages Json     @default("{}")
  sources    Json     @default("{}")
  countries  Json     @default("{}")
  devices    Json     @default("{}")

  @@id([siteId, day])
}
